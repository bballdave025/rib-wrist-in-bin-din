for i in *.zip; do \
  echo; \
  zip_filepath=$(zipinfo "${i}" | grep jpg | awk '{print $NF}'); \
  echo "zip_filepath: ${zip_filepath}"; \
  my_extension="${zip_filepath##*.}"; \
  highest_zip_dir="${zip_filepath%/*}"; \
  new_fname_pre="${i}"; \
  new_fname=$(echo "${new_fname_pre%.*}"); \
  echo "new_fname: ${new_fname}"; \
  echo " Command will be:"
  echo "unip -o -qq \"${i}\" && "\
"  mv \"${zip_filepath}\" \"./${new_fname}.${my_extension}\""; \
  echo "      ..."; \
  unzip_successful=0; \
  unzip -o -qq "${i}" && unzip_successful=1; \
  if [ $unzip_successful -eq 1 ]; then
    echo "          ... unzip success"; \
    mv "${zip_filepath}" "./${new_fname}.${my_extension}" \
      && echo "          ... rename success" \
      || echo "          ... rename FAILURE"; \
  else \
    echo "          ... unzip FAILURE ; no rename attempted."; \
  fi; \
  rm -rf "${highest_zip_dir}";
done 2>&1 | tee metz_renames_$(ttdate).out





